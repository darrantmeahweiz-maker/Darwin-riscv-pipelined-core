set_global_assignment -name VERILOG_FILE "//wsl.localhost/Ubuntu/home/userdarrant/riscv-pipelined-core/rtl/Register_File.v"
set_global_assignment -name VERILOG_FILE "//wsl.localhost/Ubuntu/home/userdarrant/riscv-pipelined-core/rtl/Register_EX_MEM.v"
set_global_assignment -name VERILOG_FILE "//wsl.localhost/Ubuntu/home/userdarrant/riscv-pipelined-core/rtl/RAS.v"
set_global_assignment -name VERILOG_FILE "//wsl.localhost/Ubuntu/home/userdarrant/riscv-pipelined-core/rtl/Pre_Decoder.v"
set_global_assignment -name VERILOG_FILE "//wsl.localhost/Ubuntu/home/userdarrant/riscv-pipelined-core/rtl/Next_PC_Logic.v"
set_global_assignment -name VERILOG_FILE "//wsl.localhost/Ubuntu/home/userdarrant/riscv-pipelined-core/rtl/Mux_ResultSrcW.v"
set_global_assignment -name VERILOG_FILE "//wsl.localhost/Ubuntu/home/userdarrant/riscv-pipelined-core/rtl/Mux_PC.v"
