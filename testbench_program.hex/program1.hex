// ============================================================================
// RISC-V 5-STAGE PIPELINE EXHAUSTIVE VERIFICATION FIRMWARE
// Covers: RV32I Base, Zmmul, Xicrc, Zbb, RAS, Speculation, & Hazard Mechanics
// ============================================================================
always @(posedge clk) begin
    if (reset) begin
        // --------------------------------------------------------------------
        // BLOCK 1: Upper Immediates & System Synchronization
        // Objective: Verify U-type parsing, PC manipulation, and system states.
        // --------------------------------------------------------------------
        32'h00400000: r_Instruction <= 32'h00001137; // [lui]    x2, 0x1 
        32'h00400004: r_Instruction <= 32'h00001197; // [auipc]  x3, 0x1 
        32'h00400008: r_Instruction <= 32'h0ff0000f; // [fence]  Sync memory/instruction streams
        32'h0040000C: r_Instruction <= 32'h00000073; // [ecall]  Trigger environment call
        32'h00400010: r_Instruction <= 32'h00100073; // [ebreak] Software breakpoint (ignored by normal pipeline)

        // --------------------------------------------------------------------
        // BLOCK 2: Base ALU (Imm & Reg) + Data Hazard Forwarding Stress
        // Objective: Trigger EX-to-EX and MEM-to-EX data forwarding paths.
        // --------------------------------------------------------------------
        32'h00400014: r_Instruction <= 32'h00f10213; // [addi]   x4, x2, 15  (Setup for forwarding)
        32'h00400018: r_Instruction <= 32'h004202b3; // [add]    x5, x4, x4  -> HAZARD: EX-to-EX forwarding required for x4
        32'h0040001C: r_Instruction <= 32'h40428333; // [sub]    x6, x5, x4  -> HAZARD: MEM-to-EX (x5) & EX-to-EX (x4)
        32'h00400020: r_Instruction <= 32'h01422393; // [slti]   x7, x4, 20
        32'h00400024: r_Instruction <= 32'h0053a433; // [slt]    x8, x7, x5
        32'h00400028: r_Instruction <= 32'h01423493; // [sltiu]  x9, x4, 20
        32'h0040002C: r_Instruction <= 32'h0054b533; // [sltu]   x10, x9, x5
        32'h00400030: r_Instruction <= 32'hfff24593; // [xori]   x11, x4, -1
        32'h00400034: r_Instruction <= 32'h0055c633; // [xor]    x12, x11, x5
        32'h00400038: r_Instruction <= 32'h00a66693; // [ori]    x13, x12, 10
        32'h0040003C: r_Instruction <= 32'h0056e733; // [or]     x14, x13, x5
        32'h00400040: r_Instruction <= 32'h00f77793; // [andi]   x15, x14, 15
        32'h00400044: r_Instruction <= 32'h0057f833; // [and]    x16, x15, x5
        
        // --- Shift Operations ---
        32'h00400048: r_Instruction <= 32'h00281893; // [slli]   x17, x16, 2
        32'h0040004C: r_Instruction <= 32'h00489933; // [sll]    x18, x17, x4
        32'h00400050: r_Instruction <= 32'h00195993; // [srli]   x19, x18, 1
        32'h00400054: r_Instruction <= 32'h0049da33; // [srl]    x20, x19, x4
        32'h00400058: r_Instruction <= 32'h401a5a93; // [srai]   x21, x20, 1
        32'h0040005C: r_Instruction <= 32'h404ad5b3; // [sra]    x22, x21, x4

        // --------------------------------------------------------------------
        // BLOCK 3: Memory Access & Load-Use Pipeline Interlocks
        // Objective: Write memory, read it back, and force 1-cycle decode stalls.
        // --------------------------------------------------------------------
        32'h00400060: r_Instruction <= 32'h01610023; // [sb]     x22, 0(x2)  (Store byte)
        32'h00400064: r_Instruction <= 32'h01611023; // [sh]     x22, 0(x2)  (Store halfword)
        32'h00400068: r_Instruction <= 32'h01612023; // [sw]     x22, 0(x2)  (Store word)
        32'h0040006C: r_Instruction <= 32'h00010b83; // [lb]     x23, 0(x2)
        32'h00400070: r_Instruction <= 32'h00011c03; // [lh]     x24, 0(x2)
        32'h00400074: r_Instruction <= 32'h00012c83; // [lw]     x25, 0(x2)
        32'h00400078: r_Instruction <= 32'h019c8d33; // [add]    x26, x25, x25 -> HAZARD: LOAD-USE STALL! Pipeline must freeze IF/ID for 1 cycle.
        32'h0040007C: r_Instruction <= 32'h00014d83; // [lbu]    x27, 0(x2)
        32'h00400080: r_Instruction <= 32'h00015e03; // [lhu]    x28, 0(x2)

        // --------------------------------------------------------------------
        // BLOCK 4: Zmmul, Xicrc, and Zbb Execution Extensions
        // Objective: Route custom hardware logic cleanly through the ALU MUX.
        // --------------------------------------------------------------------
        // --- Zmmul (Multiplication) ---
        32'h00400084: r_Instruction <= 32'h02428eb3; // [mul]    x29, x5, x4 
        32'h00400088: r_Instruction <= 32'h02429f33; // [mulh]   x30, x5, x4 
        32'h0040008C: r_Instruction <= 32'h0242afb3; // [mulhsu] x31, x5, x4 
        32'h00400090: r_Instruction <= 32'h0242b0b3; // [mulhu]  x1,  x5, x4 
        
        // --- Xicrc (CRC Hardware) ---
        32'h00400094: r_Instruction <= 32'h80428133; // [crcb]   x2, x5, x4
        32'h00400098: r_Instruction <= 32'h804291b3; // [crch]   x3, x5, x4
        32'h0040009C: r_Instruction <= 32'h8042a233; // [crcw]   x4, x5, x4

        // --- Zbb (Bit Manipulation) ---
        32'h004000A0: r_Instruction <= 32'h60029293; // [clz]    x5, x5      (rs2 hardcoded to 00000)
        32'h004000A4: r_Instruction <= 32'h60229313; // [cpop]   x6, x5      (rs2 hardcoded to 00010)
        32'h004000A8: r_Instruction <= 32'h6982d393; // [rev8]   x7, x5      (rs2 hardcoded to 11000)
        32'h004000AC: r_Instruction <= 32'h60429433; // [rol]    x8, x5, x4
        32'h004000B0: r_Instruction <= 32'h6042d4b3; // [ror]    x9, x5, x4

        // --------------------------------------------------------------------
        // BLOCK 5: Control Speculation & Return Address Stack (RAS)
        // Objective: Test dynamic call/return prediction without pipeline flushes.
        // --------------------------------------------------------------------
        32'h004000B4: r_Instruction <= 32'h014000ef; // [jal]    ra, +20 (Jump to 0x004000C8). PUSHes 0x004000B8 to RAS.
        32'h004000B8: r_Instruction <= 32'h00000013; // [nop]    If fetched during JAL, must be flushed!
        32'h004000BC: r_Instruction <= 32'h00000013; // [nop]    
        32'h004000C0: r_Instruction <= 32'h00000013; // [nop]
        32'h004000C4: r_Instruction <= 32'h0240006f; // [jal]    x0, +36 (Skip block 6 on successful return to gracefully end)
        
        // --- Inner Call (Nested RAS Test) ---
        32'h004000C8: r_Instruction <= 32'h00c002ef; // [jal]    x5, +12 (Jump to 0x004000D4). PUSHes 0x004000CC to RAS.
        32'h004000CC: r_Instruction <= 32'h00008067; // [jalr]   x0, 0(ra). POPs 0x004000B8 from RAS. Returns to main line.
        32'h004000D0: r_Instruction <= 32'h00000013; // [nop]
        
        // --- Innermost Leaf ---
        32'h004000D4: r_Instruction <= 32'h00028067; // [jalr]   x0, 0(x5). POPs 0x004000CC from RAS. (Pre-Decoder must detect x5 as secondary link).

        // --------------------------------------------------------------------
        // BLOCK 6: Branch Speculation & Misprediction Recovery
        // Objective: Test all conditional branches and force pipeline healing.
        // --------------------------------------------------------------------
        // Arrive here from address 0x004000C4
        32'h004000E8: r_Instruction <= 32'h00000513; // [addi]   x10, x0, 0
        32'h004000EC: r_Instruction <= 32'h00100593; // [addi]   x11, x0, 1
        
        32'h004000F0: r_Instruction <= 32'h00050863; // [beq]    x10, x0, +16. Predicted Taken/Not-Taken based on hardware design.
        32'h004000F4: r_Instruction <= 32'h00b51663; // [bne]    x10, x11, +12. 
        32'h004000F8: r_Instruction <= 32'h00a5c463; // [blt]    x11, x10, +8. Condition False -> Execution must NOT jump.
        32'h004000FC: r_Instruction <= 32'h00a5d263; // [bge]    x11, x10, +4. Condition True -> Flushes sequential fetched NOP.
        32'h00400100: r_Instruction <= 32'h00000013; // [nop]    Must be flushed by previous bge.
        32'h00400104: r_Instruction <= 32'h00a5e263; // [bltu]   x11, x10, +4. Condition False.
        32'h00400108: r_Instruction <= 32'h00a5f063; // [bgeu]   x11, x10, +0. Condition True.

        // --- Intentional Speculation Sabotage ---
        32'h0040010C: r_Instruction <= 32'h00c000ef; // [jal]    ra, +12. RAS PUSHes 0x00400110.
        32'h00400110: r_Instruction <= 32'h0000006f; // [jal]    x0, 0 (Infinite Halt Loop)
        32'h00400114: r_Instruction <= 32'h00000013; // [nop]
        32'h00400118: r_Instruction <= 32'h00000093; // [addi]   ra, x0, 0. SABOTAGE: Overwrites return address!
        32'h0040011C: r_Instruction <= 32'h00008067; // [jalr]   x0, 0(ra). MISPREDICT: RAS assumes 0x00400110. Actual is 0x0. 
                                                     // Branch_Monitor must catch this in EX, trigger Flush, and correct PC.
    end
end

